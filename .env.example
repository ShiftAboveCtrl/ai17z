# ─────────────────────────────────────────────────────────────────────────────
# XBAM environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Host-side connection string (native dev). Inside docker compose the api/worker
# services override this to point at the `postgres` service.
DATABASE_URL=postgres://xbam:xbam@localhost:55432/xbam
POSTGRES_USER=xbam
POSTGRES_PASSWORD=xbam
POSTGRES_DB=xbam
POSTGRES_PORT=55432

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# All provider API keys are encrypted at rest with this key (AES-256-GCM).
# Losing it makes stored provider credentials unrecoverable (re-enter them).
AI17Z_MASTER_KEY=

# ── API ─────────────────────────────────────────────────────────────────────
AI17Z_API_PORT=8787
AI17Z_API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins for the web UI.
AI17Z_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Worker ──────────────────────────────────────────────────────────────────
AI17Z_WORKER_ID=
AI17Z_WORKER_CONCURRENCY=2
AI17Z_WORKER_POLL_MS=750
AI17Z_JOB_LEASE_MS=120000

# How often the worker looks for accounts that are due to be read, and how many
# it takes at once. This is not how often any account is polled: that is cadence,
# configured per account in the UI and stored in the database.
AI17Z_POLL_TICK_MS=5000
AI17Z_POLL_ACCOUNTS_PER_TICK=5

# ── Storage ─────────────────────────────────────────────────────────────────
# Screenshots, uploaded portraits, diagnostics artifacts.
AI17Z_STORAGE_DIR=./storage
# Persistent Playwright browser profiles (managed mode).
AI17Z_BROWSER_PROFILE_DIR=./storage/browser-profiles

# ── Browser automation ──────────────────────────────────────────────────────
# Set to 0 to disable all Playwright usage (mock channel still works).
AI17Z_BROWSER_ENABLED=1
AI17Z_BROWSER_HEADLESS=0

# ── Web ─────────────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API. Leave blank to use same-origin /api.
VITE_XBAM_API_URL=http://localhost:8787

# ── Legacy migration (read-only) ────────────────────────────────────────────
# Absolute path to the immutable AI4CZ reference directory. Read-only, always.
AI4CZ_LEGACY_DIR=C:/Users/ta0as/OneDrive/Desktop/ai4cz

# ── Persona sources ─────────────────────────────────────────────────────────
# Optional. Only used by the "learn from a public X account" source; the live
# reply pipeline is Playwright-driven and does not touch this.
#
# Accepts a full command line, so a virtualenv or launcher works:
#   AI17Z_TWSCRAPE_COMMAND=twscrape
#   AI17Z_TWSCRAPE_COMMAND="C:/Python311/Scripts/twscrape.exe"
#   AI17Z_TWSCRAPE_COMMAND="/venv/bin/python" -m twscrape
#
# twscrape needs X accounts of its own: run `twscrape add_accounts` yourself.
# Those credentials live in twscrape's database; AI17Z never sees them.
AI17Z_TWSCRAPE_COMMAND=twscrape

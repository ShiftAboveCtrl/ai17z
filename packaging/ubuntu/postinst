#!/bin/sh
#
# After the package files are in place.
#
# This deliberately does almost nothing. It creates no user, initialises no
# home directory, touches nothing under /root, and never scans /home: a
# maintainer script runs as root, and the blast radius of a wrong path here is
# somebody else's data. Per-user state is created by `ai17z` on first run, as
# that user, in that user's own home.
set -e

case "$1" in
  configure)
    # Desktop environments cache these; a package that skips it installs a
    # launcher nobody can see until they log out.
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -qf /usr/share/icons/hicolor 2>/dev/null || true
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure) ;;
esac

exit 0

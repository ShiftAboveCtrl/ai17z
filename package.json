{
  "name": "xbam",
  "private": true,
  "version": "1.0.0-beta.15",
  "license": "MIT",
  "type": "module",
  "description": "XBAM — a local-first universal autonomous-agent platform.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker",
    "apps/web",
    "tools/*"
  ],
  "scripts": {
    "setup": "node scripts/ensure-env.mjs",
    "predev": "node scripts/ensure-env.mjs",
    "premigrate": "node scripts/ensure-env.mjs",
    "predb:up": "node scripts/ensure-env.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "migrate": "tsx packages/database/src/cli/migrate.ts",
    "migrate:status": "tsx packages/database/src/cli/migrate.ts status",
    "seed": "tsx packages/database/src/cli/seed.ts",
    "bootstrap": "npm run migrate && npm run seed",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:web": "npm --workspace @xbam/web run dev",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "build:web": "npm --workspace @xbam/web run build",
    "typecheck": "tsc -b tsconfig.json --pretty false && tsc -p tests/e2e/tsconfig.json --noEmit && npm --workspace @xbam/web exec tsc -- --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "session:e2e": "tsx tools/e2e-session.mts",
    "import:ai4cz": "tsx tools/import-ai4cz/src/cli.ts",
    "browser:cdp": "powershell -ExecutionPolicy Bypass -File scripts/launch-chrome-cdp.ps1",
    "soak": "tsx tools/soak.mts",
    "package:windows": "tsx tools/package-windows.mts",
    "verify:install": "tsx tools/verify-install.mts",
    "owner:password": "tsx tools/owner-password.mts",
    "worker:supervised": "tsx scripts/supervise-worker.mts",
    "release:check": "tsx tools/release-check.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "worker:present": "tsx scripts/browser-worker-present.mts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  }
}

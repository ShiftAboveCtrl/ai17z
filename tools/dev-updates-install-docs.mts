import { readFileSync, writeFileSync } from 'node:fs';
import { devUpdatesMcpConfig, mcpAddCommand } from '../packages/shared/src/contracts/devUpdatesInstall';

const example = {
  serverName: 'ai17z-dev-updates',
  apiUrl: 'http://localhost:8787',
  token: 'ai17z_dus_REPLACE_WITH_SENDER_TOKEN',
  projectKey: 'my-project',
  serverPath: '/path/to/ai17z/tools/dev-updates-mcp.mjs',
};
const block = [
  '<!-- dev-updates-install:start -->',
  '<!-- Generated by npm run dev-updates:docs. Edit the shared builder, then regenerate. -->',
  '```sh',
  mcpAddCommand(example),
  '```',
  '',
  'For other coding assistants, use this generic MCP JSON:',
  '',
  '```json',
  JSON.stringify({ mcpServers: { [example.serverName]: devUpdatesMcpConfig(example) } }, null, 2),
  '```',
  '<!-- dev-updates-install:end -->',
].join('\n');

for (const file of ['README.md', 'docs/architecture/DEV_UPDATES.md']) {
  const url = new URL(`../${file}`, import.meta.url);
  const original = readFileSync(url, 'utf8');
  const pattern = /<!-- dev-updates-install:start -->[\s\S]*?<!-- dev-updates-install:end -->/;
  if (!pattern.test(original)) throw new Error(`Missing installation markers in ${file}`);
  writeFileSync(url, original.replace(pattern, block));
}
